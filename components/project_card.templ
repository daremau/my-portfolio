package components

import (
	"strconv"

	"github.com/daremau/my-portfolio/internal/content"
)

templ ProjectCard(project content.Project, featured bool) {
	<article class={ ProjectCardClass(featured) }>
		<div class="project-cover">
			<img
				src={ "./" + project.Cover }
				alt={ project.Title + " screenshot" }
				loading="lazy"
				decoding="async"
			/>
		</div>
		<div class="project-body">
			<div class="project-heading">
				<h3 class="project-title">
					if project.Repo != "" {
						<a href={ project.Repo } target="_blank" rel="noopener noreferrer">{ project.Title }</a>
					} else {
						{ project.Title }
					}
				</h3>
				if project.Year > 0 {
					<span class="project-year">{ strconv.Itoa(project.Year) }</span>
				}
			</div>
			<p class="project-description">{ project.Description }</p>
			<p class="project-stack">{ project.StackLine() }</p>
			<div class="project-links">
				if project.Repo != "" {
					<a class="text-link" href={ project.Repo } target="_blank" rel="noopener noreferrer">
						GitHub <span aria-hidden="true">↗</span>
					</a>
				}
				if project.Demo != "" {
					<a class="text-link" href={ project.Demo } target="_blank" rel="noopener noreferrer">
						Live demo <span aria-hidden="true">↗</span>
					</a>
				}
				if project.Repo == "" && project.Demo == "" {
					<span class="private-label">Private project</span>
				}
			</div>
		</div>
	</article>
}
