package components

import (
	"strconv"
	"time"
)

templ Layout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" type="image/svg+xml" href="./favicon.svg"/>
			<link rel="icon" href="./favicon.ico"/>
			<meta name="description" content="Portfolio showcasing web development, data science, and AI engineering projects"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="./styles.css"/>
			<script>
				(function () {
					document.documentElement.classList.add('js');
					var stored = localStorage.getItem('theme');
					var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (dark) {
						document.documentElement.classList.add('dark');
					}
				})();
			</script>
		</head>
		<body>
			<nav class="site-nav">
				<div class="container nav-inner">
					<a href="./" class="brand">Portfolio</a>
					<div class="nav-links">
						<a href="#about" class="nav-link">About</a>
						<a href="#projects" class="nav-link">Projects</a>
						<a href="./CV.pdf" download class="nav-link">Resume</a>
						<button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
							<svg class="theme-icon theme-icon-sun" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
								<path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
							</svg>
							<svg class="theme-icon theme-icon-moon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
								<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
							</svg>
						</button>
					</div>
				</div>
			</nav>
			<main class="site-main">
				<div class="container">
					@content
				</div>
			</main>
			<footer class="site-footer">
				<div class="container">
					<p>&copy; { strconv.Itoa(time.Now().Year()) } Your Name. All rights reserved.</p>
				</div>
			</footer>
			<script src="./main.js" defer></script>
		</body>
	</html>
}
