package components

import (
	"strconv"
	"time"
)

templ Layout(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<link rel="icon" type="image/svg+xml" href="./favicon.svg"/>
			<meta name="description" content="Mauricio Da Re — full-stack engineer building web applications, internal tools, and AI products."/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="./styles.css"/>
			<script>
				(function () {
					var stored = localStorage.getItem('theme');
					var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
					if (dark) {
						document.documentElement.classList.add('dark');
					}
				})();
			</script>
		</head>
		<body>
			<nav class="site-nav">
				<div class="container nav-inner">
					<a href="./" class="brand">Mauricio Da Re</a>
					<div class="nav-links">
						<a href="#work" class="nav-link">Work</a>
						<a href="#about" class="nav-link">About</a>
						<a href="#contact" class="nav-link">Contact</a>
						<a
							class="nav-icon"
							href={ GitHubURL }
							target="_blank"
							rel="noopener noreferrer"
							aria-label="GitHub profile"
						>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
							</svg>
						</a>
						<button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
							<svg class="theme-icon theme-icon-sun" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
								<path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" clip-rule="evenodd"></path>
							</svg>
							<svg class="theme-icon theme-icon-moon" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
								<path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
							</svg>
						</button>
					</div>
				</div>
			</nav>
			<main class="site-main">
				<div class="container">
					@content
				</div>
			</main>
			<footer class="site-footer">
				<div class="container footer-inner">
					<p>&copy; { strconv.Itoa(time.Now().Year()) } Mauricio Da Re</p>
					<p>Built with Go · <a href={ GitHubURL } target="_blank" rel="noopener noreferrer">GitHub</a></p>
				</div>
			</footer>
			<script src="./main.js" defer></script>
		</body>
	</html>
}
