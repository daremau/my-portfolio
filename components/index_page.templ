package components

import "github.com/daremau/my-portfolio/internal/content"

templ IndexPage(projects []content.Project) {
	<section class="hero">
		<p class="hero-role">Full-stack engineer</p>
		<h1>Mauricio Da Re</h1>
		<p class="hero-lede">I build multi-tenant SaaS, internal tools, and AI products.</p>
		<p class="hero-copy">
			Most of my work is TypeScript, Next.js, NestJS, and Postgres. I care about
			clean data boundaries, reliable systems, and interfaces that stay out of the way.
		</p>
		<div class="hero-links">
			<a class="text-link" href={ GitHubURL } target="_blank" rel="noopener noreferrer">
				GitHub <span aria-hidden="true">↗</span>
			</a>
			<a class="text-link" href={ EmailURL }>
				Email <span aria-hidden="true">↗</span>
			</a>
		</div>
	</section>
	<section id="work" class="section">
		<div class="section-head">
			<h2>Selected work</h2>
			<p>A few projects I've designed and built recently.</p>
		</div>
		<div class="project-grid">
			for i, project := range projects {
				@ProjectCard(project, i == 0)
			}
		</div>
		if len(projects) == 0 {
			<p class="empty-state">No projects yet.</p>
		}
		<div class="more-projects">
			<div class="more-head">
				<h3>More on GitHub</h3>
				<a class="text-link" href={ AllReposURL } target="_blank" rel="noopener noreferrer">
					All repositories <span aria-hidden="true">↗</span>
				</a>
			</div>
			<ul class="repo-list">
				for _, project := range OtherProjects() {
					<li class="repo-item">
						<div class="repo-main">
							<a class="repo-name" href={ project.URL } target="_blank" rel="noopener noreferrer">
								{ project.Name }
							</a>
							<p class="repo-desc">{ project.Description }</p>
						</div>
						<span class="repo-lang">{ project.Language }</span>
					</li>
				}
			</ul>
		</div>
	</section>
	<section id="about" class="section">
		<div class="section-head">
			<h2>About</h2>
		</div>
		<div class="about-grid">
			<div class="about-text">
				<p>
					I'm a full-stack engineer based in Paraguay. I build products end to
					end — from the database schema and API design to the interface people
					actually use.
				</p>
				<p>
					Recently I've been working on multi-tenant SaaS: Atlas CRM, a B2B CRM
					built around row-level security, optimistic concurrency, and a
					transactional outbox; and SupportFlow AI, a customer-support platform
					with grounded RAG, citations, and human handoff.
				</p>
				<p>
					Outside of product work, I spend time on data and ML projects,
					developer tooling, and the occasional game or simulation.
				</p>
			</div>
			<div class="skills">
				<h3>Tools I use</h3>
				<dl>
					for _, group := range SkillGroups() {
						<div class="skill-group">
							<dt>{ group.Label }</dt>
							<dd>{ group.List() }</dd>
						</div>
					}
				</dl>
			</div>
		</div>
	</section>
	<section id="contact" class="section contact">
		<div class="contact-inner">
			<div>
				<h2>Get in touch</h2>
				<p>If you'd like to talk about a project or role, email me. I'm also on GitHub.</p>
			</div>
			<div class="contact-links">
				<a class="btn btn-primary" href={ EmailURL }>
					{ Email } <span aria-hidden="true">↗</span>
				</a>
				<a class="btn btn-secondary" href={ GitHubURL } target="_blank" rel="noopener noreferrer">
					GitHub <span aria-hidden="true">↗</span>
				</a>
			</div>
		</div>
	</section>
}
