---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const categories = ['All', 'Web Dev', 'Data Science', 'AI Engineering'];
---

<BaseLayout title="Portfolio | Web Dev, Data Science & AI">
  <!-- Hero Section -->
  <section class="py-20 md:py-32">
    <div class="fade-in">
      <p class="text-primary-600 dark:text-primary-400 font-medium mb-4">Hi, I'm</p>
      <h1 class="text-4xl md:text-6xl font-bold text-slate-900 dark:text-white leading-tight">
        Your Name
      </h1>
      <p class="mt-6 text-xl text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed">
        Building intelligent systems and beautiful web experiences.
        I specialize in <span class="text-primary-600 dark:text-primary-400 font-medium">Web Development</span>,
        <span class="text-primary-600 dark:text-primary-400 font-medium">Data Science</span>, and
        <span class="text-primary-600 dark:text-primary-400 font-medium">AI Engineering</span>.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          href="/CV.pdf"
          download
          class="inline-flex items-center gap-2 bg-primary-600 text-white px-6 py-3 rounded-lg hover:bg-primary-700 transition-colors font-medium"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download Resume
        </a>
        <a
          href="#projects"
          class="inline-flex items-center gap-2 border border-slate-300 dark:border-slate-600 text-slate-700 dark:text-slate-300 px-6 py-3 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors font-medium"
        >
          View Projects
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="py-16 border-t border-slate-200 dark:border-slate-800">
    <div class="fade-in">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">About Me</h2>
      <div class="grid md:grid-cols-2 gap-12">
        <div class="space-y-4 text-slate-600 dark:text-slate-400">
          <p>
            I'm a developer passionate about building solutions that make a difference.
            My work spans across web development, data science, and AI engineering.
          </p>
          <p>
            When I'm not coding, you'll find me exploring new technologies, contributing to
            open source projects, or diving deep into machine learning research.
          </p>
        </div>
        <div class="space-y-6">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Skills & Technologies</h3>
          <div class="flex flex-wrap gap-2">
            {['Python', 'JavaScript', 'TypeScript', 'React', 'Node.js', 'PostgreSQL', 'TensorFlow', 'PyTorch', 'Pandas', 'Docker', 'AWS', 'Git'].map(skill => (
              <span class="px-3 py-1 bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-full text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="py-16 border-t border-slate-200 dark:border-slate-800">
    <div class="fade-in">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">Projects</h2>

      <!-- Filter Tabs -->
      <div class="flex flex-wrap gap-2 mb-8" role="tablist">
        {categories.map((category, index) => (
          <button
            data-filter={category}
            class:list={[
              'filter-btn px-4 py-2 rounded-lg font-medium transition-colors',
              index === 0
                ? 'bg-primary-600 text-white'
                : 'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700'
            ]}
            role="tab"
            aria-selected={index === 0}
          >
            {category}
          </button>
        ))}
      </div>

      <!-- Projects Grid -->
      <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allProjects.map((project, index) => (
          <div class={`project-item fade-in stagger-${(index % 6) + 1}`} data-category={project.data.category}>
            <ProjectCard project={project.data} />
          </div>
        ))}
      </div>

      {allProjects.length === 0 && (
        <p class="text-center text-slate-500 dark:text-slate-400 py-12">
          No projects yet. Check back soon!
        </p>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Project filtering functionality
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectItems = document.querySelectorAll<HTMLDivElement>('.project-item');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');

      // Update active button
      filterButtons.forEach(btn => {
        btn.classList.remove('bg-primary-600', 'text-white');
        btn.classList.add('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
        btn.setAttribute('aria-selected', 'false');
      });
      button.classList.remove('bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300');
      button.classList.add('bg-primary-600', 'text-white');
      button.setAttribute('aria-selected', 'true');

      // Filter projects
      projectItems.forEach(item => {
        const category = item.getAttribute('data-category');
        if (filter === 'All' || category === filter) {
          item.style.display = 'block';
          // Re-trigger fade-in animation
          item.classList.remove('visible');
          setTimeout(() => item.classList.add('visible'), 10);
        } else {
          item.style.display = 'none';
        }
      });
    });
  });

  // Trigger initial animations
  document.querySelectorAll('.fade-in').forEach(el => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
        }
      });
    }, { threshold: 0.1 });
    observer.observe(el);
  });
</script>
